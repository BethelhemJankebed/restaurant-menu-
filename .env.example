# ====================================================================
# LE BORDEAUX RESTAURANT MENU - PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Database Connection URL
# For SQLite (default, ideal for single VPS or Docker container):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (recommended for serverless platforms like Vercel, Supabase, Neon):
# DATABASE_URL="postgresql://user:password@hostname:5432/lebordeaux?schema=public&sslmode=require"

# 2. JWT Authentication Secret
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-cryptographically-secure-random-32-char-secret"

# 3. Application Public URL (Used for absolute URLs, canonical tags, and CORS)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# 4. Node Environment
NODE_ENV="production"
